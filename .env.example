# Atlassian OAuth 2.0 (3LO) App Credentials
# Register at: https://developer.atlassian.com/console/myapps/
# 1. Create an OAuth 2.0 (3LO) app
# 2. Set callback URL to: http://localhost:3001/callback
# 3. Add scopes: read:jira-work, write:jira-work, read:confluence-content.all,
#    read:confluence-space.summary, offline_access
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

# OAuth callback URL (must match what's registered in the Atlassian app)
ATLASSIAN_OAUTH_CALLBACK_URL=http://localhost:3001/callback

# Atlassian API scopes (space-separated)
ATLASSIAN_OAUTH_SCOPES=read:jira-work write:jira-work read:confluence-content.all read:confluence-space.summary offline_access

# Gateway settings
GATEWAY_PORT=3001
GATEWAY_URL=http://localhost:3001
LOG_LEVEL=INFO

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Token Encryption Key (required)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# These are set automatically by LibreChat via MCP env placeholders:
# OPENID_ACCESS_TOKEN (user's Azure AD access token - for extracting email)
# OPENID_ID_TOKEN (user's Azure AD ID token - fallback for email)
